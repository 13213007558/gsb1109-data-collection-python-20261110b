#!/usr/bin/env python3

import os
import sys
import subprocess
from io import open

PYTHON_VERSIONS = ["3"]

"""
This test uses sys.stdout.
That means this test doesn't verify:
    - file output process
    - differences from sys.stdout like line terminater
"""

def compare(case, arguments=[]):
    failed = False
    for pyver in PYTHON_VERSIONS:
        ext = "xlsx"
        if os.path.exists("test/%s.xlsm" % case):
            ext = "xlsm"

        if os.name == 'posix':# in case of Linux
            command = ["python%s" %pyver]
        elif os.name == 'nt':# in case of Windows
            # Use py.exe http://blog.python.org/2011/07/python-launcher-for-windows_11.html on Windows
            command = ["py", "-%s" %pyver] 
        else:
            print("os.name is unexpected: "+os.name)
            sys.exit(1)
        left = subprocess.check_output(command + ["./xlsx2csv.py"] + arguments + ["test/%s.%s" %(case, ext)]).decode('utf-8').replace('\r','')

        f = open("test/%s.csv" %case, "r", encoding="utf-8", newline="")
        right = f.read().replace('\r','')
        f.close()

        if left != right:
            print("FAILED: %s %s" %(case, pyver))
            print(" actual:", left.replace("\r", "\\r").replace("\n", "\\n"))
            print(" expected:", right.replace("\r", "\\r").replace("\n", "\\n"))
            failed = True
        else:
            print("OK: %s %s" %(case, pyver))

        # test STDIN, only works for python3
        if pyver == "2":
            continue

        xfile = open("test/%s.%s" %(case,ext), "rb")
        stdin = xfile.read()
        xfile.close()

        pipe = subprocess.run(command + ["./xlsx2csv.py"] + arguments + ["-"], input = stdin, capture_output = True)
        stdinleft = pipe.stdout.decode("utf-8").replace('\r','').replace('\r','')

        if stdinleft != right:
            print("FAILED (STDIN): %s %s" %(case, pyver))
            failed = True
        else:
            print("OK (STDIN): %s %s" %(case, pyver))

    if failed:
        sys.exit(1)


compare("datetime", ["--dateformat=%Y-%m-%d %H:%M:%S"])
compare("empty_row")
compare("junk-small")
compare("last-column-empty")
compare("sheets", ["-a"])
compare("skip_empty_lines", ["-i"])
compare("twolettercolumns")
compare("xlsx2csv-test-file")
compare("escape", ["-e"])
compare("hyperlinks", ["--hyperlinks"])
compare("hyperlinks_continous", ["--hyperlinks"])
compare("namespace")
compare("float")
compare("variousdelim", ["--all","--sheetdelimiter=x33", "--lineterminator=\\r", "--delimiter=\\t"])
compare("utf8")
compare("no_cell_ids")
compare("sheets_order", ["-a"])
compare("formatted_inline_string")
compare("float_formatting", ["--floatformat=%f"])
compare("float_formatting_custom0", ["--floatformat=%.0f"])
compare("float_formatting_custom2", ["--floatformat=%.2f"])
compare("percentage")
compare("percentage_ignore", ["--ignore-percentage"])
compare("shared_string_oob")
compare("quoted_literals")
compare("date1904_0")
compare("date1904_1")
compare("hidden_rows")


def test_dir_sheetname():
    # --sheetname must apply to directory input too, including nested folders (#320)
    import shutil, tempfile
    cmd = [sys.executable, "./xlsx2csv.py", "-n", "e"]
    expected = subprocess.check_output(cmd + ["test/sheets_order.xlsx"])
    tmp = tempfile.mkdtemp()
    try:
        os.mkdir(os.path.join(tmp, "nested"))
        shutil.copy("test/sheets_order.xlsx", os.path.join(tmp, "a.xlsx"))
        shutil.copy("test/sheets_order.xlsx", os.path.join(tmp, "nested", "b.xlsx"))
        subprocess.check_output(cmd + [tmp])
        for out in (os.path.join(tmp, "a.csv"), os.path.join(tmp, "nested", "b.csv")):
            f = open(out, "rb")
            actual = f.read()
            f.close()
            if actual != expected:
                print("FAILED: dir_sheetname %s" % out)
                sys.exit(1)
    finally:
        shutil.rmtree(tmp)
    print("OK: dir_sheetname")

test_dir_sheetname()


def test_plan_mode():
    # --plan lists input/sheet/target paths, flags conflicts using the target
    # filesystem's case rules, never writes CSV, and a saved plan is re-checked
    # against the source workbooks before it is applied.
    import json
    import shutil
    import tempfile

    root = tempfile.mkdtemp()
    try:
        indir = os.path.join(root, "in")
        outdir = os.path.join(root, "out")
        os.mkdir(indir)
        os.mkdir(os.path.join(indir, "sub1"))
        os.mkdir(os.path.join(indir, "sub2"))
        os.mkdir(outdir)
        # same stem in two folders: all-sheets output paths collide
        shutil.copy("test/sheets_order.xlsx", os.path.join(indir, "sub1", "a.xlsx"))
        shutil.copy("test/sheets_order.xlsx", os.path.join(indir, "sub2", "a.xlsx"))

        def run(args):
            return subprocess.run([sys.executable, "./xlsx2csv.py"] + args,
                                  capture_output=True, text=True)

        pipe = run(["--plan", "-a", indir, outdir])
        if pipe.returncode == 0 or "CONFLICT:" not in pipe.stdout:
            print("FAILED: plan_mode conflict not reported")
            print(pipe.stdout, pipe.stderr)
            sys.exit(1)
        if "case-insensitive" not in pipe.stdout and "case-sensitive" not in pipe.stdout:
            print("FAILED: plan_mode filesystem case rule not reported")
            sys.exit(1)
        for base, _dirs, files in os.walk(root):
            if any(name.endswith(".csv") for name in files):
                print("FAILED: plan_mode created CSV files")
                sys.exit(1)
        # conflicting plans must not be saved
        conflict_plan = os.path.join(root, "conflict.json")
        pipe = run(["--plan", "-a", "--plan-file", conflict_plan, indir, outdir])
        if pipe.returncode == 0 or os.path.exists(conflict_plan):
            print("FAILED: conflicting plan was saved")
            sys.exit(1)

        # resolve the clash: give the second workbook a unique stem
        os.rename(os.path.join(indir, "sub2", "a.xlsx"),
                  os.path.join(indir, "sub2", "b.xlsx"))
        plan_path = os.path.join(root, "plan.json")
        pipe = run(["--plan", "-a", "--plan-file", plan_path, indir, outdir])
        if pipe.returncode != 0 or not os.path.exists(plan_path):
            print("FAILED: clean plan was not saved")
            print(pipe.stdout, pipe.stderr)
            sys.exit(1)
        for base, _dirs, files in os.walk(outdir):
            if files:
                print("FAILED: planning wrote output files")
                sys.exit(1)

        # tamper with the confirmed plan: the recorded sheet list of one
        # workbook no longer matches the live source, so applying must
        # require re-confirmation
        with open(plan_path, "r", encoding="utf-8") as f:
            data = json.load(f)
        changed_input = next(iter(data["workbook_sheets"]))
        data["workbook_sheets"][changed_input][0][1] = "renamed-sheet"
        stale_plan = os.path.join(root, "stale.json")
        with open(stale_plan, "w", encoding="utf-8") as f:
            json.dump(data, f)
        pipe = run(["--plan-file", stale_plan, indir, outdir])
        if pipe.returncode == 0:
            print("FAILED: stale plan was applied")
            sys.exit(1)

        # apply the still-valid plan and compare with a normal batch run
        pipe = run(["--plan-file", plan_path, indir, outdir])
        if pipe.returncode != 0:
            print("FAILED: confirmed plan not applied")
            print(pipe.stdout, pipe.stderr)
            sys.exit(1)
        refdir = os.path.join(root, "ref")
        os.mkdir(refdir)
        subprocess.check_call([sys.executable, "./xlsx2csv.py", "-a", indir, refdir],
                              stdout=subprocess.DEVNULL)

        def output_files(folder):
            result = []
            for base, _dirs, files in os.walk(folder):
                for name in files:
                    full = os.path.join(base, name)
                    with open(full, "rb") as f:
                        result.append((os.path.relpath(full, folder), f.read()))
            return sorted(result)

        if output_files(outdir) != output_files(refdir):
            print("FAILED: planned output differs from normal batch output")
            sys.exit(1)
    finally:
        shutil.rmtree(root)
    print("OK: plan_mode")


test_plan_mode()
